    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const row = item.json;\n  \n  // Skip row if essential info is missing\n  if (!row.error_code && !row.resolution) {\n    return null; \n  }\n\n  // Safely join troubleshooting steps if it's an array or string\n  let steps = '';\n  if (Array.isArray(row.troubleshooting_steps)) {\n    steps = row.troubleshooting_steps.join(', ');\n  } else if (typeof row.troubleshooting_steps === 'string') {\n    steps = row.troubleshooting_steps;\n  }\n\n  // Combine columns into a single flat text block per row\n  const combinedText = `Vehicle Model: ${row.vehicle_model || 'N/A'} | Charger Type: ${row.charger_type || 'N/A'} | Error Code: ${row.error_code || 'N/A'} | Issue Subtype: ${row.issue_subtype || 'N/A'} | Troubleshooting Steps: ${steps} | Root Cause: ${row.root_cause || 'N/A'} | Resolution: ${row.resolution || 'N/A'}`;\n\n  // Returns ONLY a single flat property containing the string\n  return {\n    json: {\n      text: combinedText\n    }\n  };\n}).filter(Boolean);"
      },
